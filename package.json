{
  "name": "notebooklm-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-build.mjs && tsc -b --force && vite build",
    "start": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:database": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/database/run.ps1",
    "test:functions": "deno test --config tests/functions/deno.json --allow-env tests/functions/",
    "check:functions": "deno check --config supabase/functions/notebook-ai/deno.json supabase/functions/notebook-ai/index.ts && deno check --config supabase/functions/source-import/deno.json supabase/functions/source-import/index.ts",
    "check:function-sizes": "node scripts/check-function-sizes.mjs",
    "verify:supabase": "node --env-file=.env tests/deployment/verify-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
